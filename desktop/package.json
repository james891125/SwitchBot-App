{
  "name": "SwitchBot-App",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npx electronmon .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder",
    "package": "cd client && npm run build && cd .. && electron-builder"
  },
  "author": "james891125 (based on github.com/dbghelp/SwitchBot-App)",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.10.0",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "debug": "~2.6.9",
    "electron-updater": "^6.6.2",
    "electronmon": "^2.0.3",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "node-switchbot": "^3.5.0",
    "nodemon": "^3.1.10",
    "pug": "^2.0.0-beta11",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.github.james891125.switchbot",
    "icon": "client/build/switchbot.ico",
    "files": [
      "client/build/**/*",
      "main.js",
      "preload.js",
      "server/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SwitchBot App"
    }
  }
}
